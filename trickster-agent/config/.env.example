# Mu Agent — Environment Variables
# Copy to .env and fill in your keys

# Moltbook API (get from registration)
MOLTBOOK_API_KEY=moltbook_xxx

# Anthropic (for Claude LLM)
ANTHROPIC_API_KEY=sk-ant-xxx

# Admin UI token (optional, recommended)
ADMIN_TOKEN=change_me

# Runware (for image generation)
RUNWARE_API_KEY=xxx

# Pollinations Enter (optional, key-based API mode)
POLLINATIONS_API_KEY=xxx

# fal.ai (optional, for video generation via queue API)
FAL_KEY=xxx

# Objkt mint webhook auth token (optional, used by NFT module)
OBJKT_WEBHOOK_TOKEN=xxx
# Optional worker overrides
# OBJKT_WORKER_MODE=dry_run
# OBJKT_MINT_CMD=
# OBJKT_PRIVATE_KEY=
# OBJKT_FA2_CONTRACT=

# ComfyUI (optional, if using auth)
# COMFYUI_API_KEY=xxx

# vast.ai (optional, for remote GPU)
# VASTAI_API_KEY=xxx
